{
  "name": "feishu-codex-bridge",
  "version": "0.4.0",
  "private": true,
  "packageManager": "bun@1.4.2",
  "description": "Run Codex tasks from Feishu using AAMP or the native direct bridge.",
  "type": "module",
  "bin": {
    "feishu-codex-bridge": "bin/feishu-codex-bridge.mjs"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "preinstall": "bun scripts/check-bun-version.mjs",
    "build": "bun run build:web && bun run --bun tsc -p tsconfig.json && bun run --bun tsc -p web/tsconfig.json --noEmit",
    "release": "bun scripts/build-bun-single-binary-release.mjs",
    "release:legacy": "bun scripts/build-portable-release.mjs",
    "portable:restart": "bun scripts/restart-portable-release.mjs",
    "release:github": "bun scripts/publish-github-release.mjs",
    "build:web": "bun run --bun vite build --config web/vite.config.ts",
    "dev": "bun --watch src/main.ts",
    "dev:api": "bun --watch src/main.ts --web-only --web-port 17310 --config ./config.example.json --db ./runtime/dev/bridge.db",
    "dev:tmux-api": "bun --watch src/main.ts --web-only --web-port 17310 --config ./config.example.json --db ./runtime/dev/bridge.db",
    "dev:web": "BRIDGE_WEB_API_TARGET=http://127.0.0.1:17310 bun run --bun vite --config web/vite.config.ts",
    "web:pair": "bun src/web-pair-cli.ts",
    "start": "bun dist/main.js",
    "start:all": "bun dist/main.js",
    "aamp": "bun src/aamp-cli.ts",
    "aamp:install": "bun src/aamp-cli.ts install",
    "aamp:start": "bun src/aamp-cli.ts start",
    "aamp:stop": "bun src/aamp-cli.ts stop",
    "aamp:restart": "bun src/aamp-cli.ts restart",
    "aamp:status": "bun src/aamp-cli.ts status",
    "aamp:logs": "bun src/aamp-cli.ts logs",
    "aamp:recent": "bun src/aamp-cli.ts recent",
    "aamp:task": "bun src/aamp-cli.ts task",
    "aamp:inspect": "bun src/aamp-cli.ts inspect",
    "aamp:worktrees": "bun src/aamp-cli.ts worktrees",
    "aamp:update": "bun src/aamp-cli.ts update",
    "codex": "bun src/codex-cli.ts",
    "codex:install": "bun src/codex-cli.ts install",
    "codex:setup": "bun src/codex-cli.ts setup",
    "codex:uninstall": "bun src/codex-cli.ts uninstall",
    "codex:remove": "bun src/codex-cli.ts remove",
    "codex:start": "bun src/codex-cli.ts start",
    "codex:stop": "bun src/codex-cli.ts stop",
    "codex:restart": "bun src/codex-cli.ts restart",
    "codex:status": "bun src/codex-cli.ts status",
    "codex:logs": "bun src/codex-cli.ts logs",
    "codex:recent": "bun src/codex-cli.ts recent",
    "codex:notify": "bun src/codex-cli.ts notify",
    "codex:notify-install": "bun src/codex-cli.ts notify-install",
    "codex:notify-hook": "bun src/codex-cli.ts notify-hook",
    "codex:list": "bun src/codex-cli.ts list",
    "codex:threads": "bun src/codex-cli.ts threads",
    "codex:thread": "bun src/codex-cli.ts thread",
    "codex:task": "bun src/codex-cli.ts task",
    "codex:inspect": "bun src/codex-cli.ts inspect",
    "codex:attachments": "bun src/codex-cli.ts attachments",
    "codex:outbox": "bun src/codex-cli.ts outbox",
    "codex:cancel": "bun src/codex-cli.ts cancel",
    "codex:retry": "bun src/codex-cli.ts retry",
    "codex:recover": "bun src/codex-cli.ts recover",
    "codex:worktrees": "bun src/codex-cli.ts worktrees",
    "codex:doctor": "bun src/codex-cli.ts doctor",
    "codex:update": "bun src/codex-cli.ts update",
    "bridge:install": "bun src/install-cli.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "bun run --bun tsc -p tsconfig.json --noEmit && bun run --bun tsc -p web/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.19",
    "@larksuite/cli": "1.0.94",
    "@larksuiteoapi/node-sdk": "1.73.3",
    "@larktask/aamp-feishu-task-agent": "0.1.1-dev.8",
    "@openai/codex-sdk": "^0.104.0",
    "@xterm/addon-canvas": "0.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "qrcode": "1.5.4",
    "qrcode-terminal": "0.12.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router": "^8.4.0",
    "ws": "^8.21.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@types/qrcode-terminal": "0.12.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.7.3",
    "vconsole": "3.15.1",
    "vconsole-outputlog-plugin": "0.3.0",
    "vite": "^6.4.3"
  }
}
